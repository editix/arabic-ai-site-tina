    <script is:inline>
        /* Assistants carousel: vertical cards, seamless infinite loop, hover-edge advance */
        (function() {
          const root = document.getElementById('assistantsCarousel');
          if (!root) return;
          const cards = Array.from(root.querySelectorAll('.assistant'));
          const leftZone = root.querySelector('.assistants-zone.left');
          const rightZone = root.querySelector('.assistants-zone.right');
          const n = cards.length;
          let active = 0;
      
          function position() {
            cards.forEach((card, i) => {
              let offset = i - active;
              // Shortest signed offset (seamless wrap)
              if (offset > n / 2) offset -= n;
              else if (offset < -n / 2) offset += n;
              const abs = Math.abs(offset);
              let x, scale, opacity, z;
              if (abs === 0)       { x =     0;               scale = 1;    opacity = 1;    z = 10; }
              else if (abs === 1)  { x = offset * 315;        scale = 0.92; opacity = 0.85; z = 8;  }
              else if (abs === 2)  { x = offset * 540;        scale = 0.82; opacity = 0.45; z = 6;  }
              else                 { x = offset > 0 ? 700 : -700; scale = 0.72; opacity = 0; z = 1; }
              /* Vertical — no rotation */
              card.style.transform = `translate(-50%, calc(-50% - 18px)) translateX(${x}px) scale(${scale})`;
              card.style.left = '50%';
              card.style.top = '50%';
              card.style.opacity = opacity;
              card.style.zIndex = z;
              const wasActive = card.classList.contains('is-active');
              const isActive = i === active;
              card.classList.toggle('is-active', isActive);
              card.setAttribute('tabindex', isActive ? '0' : '-1');
              // Reset tilt when a card transitions out of the active slot
              if (wasActive && !isActive) {
                const tiltReset = card.querySelector('.assistant-tilt');
                if (tiltReset) {
                  tiltReset.style.transition = 'transform 0.55s cubic-bezier(0.23, 1, 0.32, 1)';
                  tiltReset.style.transform = '';
                }
              }
            });
          }
      
          function advance(dir) {
            active = (active + dir + n) % n;
            position();
          }
      
          let timer = null;
          function startHover(dir) {
            advance(dir);
            timer = setInterval(() => advance(dir), 1100);
          }
          function stopHover() {
            clearInterval(timer);
            timer = null;
          }
      
          leftZone.addEventListener('mouseenter', () => startHover(-1));
          leftZone.addEventListener('mouseleave', stopHover);
          leftZone.addEventListener('click', () => advance(-1));
          rightZone.addEventListener('mouseenter', () => startHover(1));
          rightZone.addEventListener('mouseleave', stopHover);
          rightZone.addEventListener('click', () => advance(1));
      
          // Clicking a non-center card brings it to the center (and prevents navigation)
          cards.forEach((card, i) => {
            card.addEventListener('click', (e) => {
              if (i !== active) {
                e.preventDefault();
                active = i;
                position();
              }
            });
      
            // TiltedCard-style hover: active center card tilts in response to mouse
            const tiltEl = card.querySelector('.assistant-tilt');
            if (tiltEl) {
              card.addEventListener('mousemove', (e) => {
                if (!card.classList.contains('is-active')) return;
                const rect = card.getBoundingClientRect();
                const offsetX = e.clientX - rect.left - rect.width / 2;
                const offsetY = e.clientY - rect.top - rect.height / 2;
                const rotX = (offsetY / (rect.height / 2)) * -10;
                const rotY = (offsetX / (rect.width / 2)) * 10;
                tiltEl.style.transition = 'transform 0.08s linear';
                tiltEl.style.transform = `rotateX(${rotX}deg) rotateY(${rotY}deg) scale(1.04)`;
              });
              card.addEventListener('mouseleave', () => {
                tiltEl.style.transition = 'transform 0.55s cubic-bezier(0.23, 1, 0.32, 1)';
                tiltEl.style.transform = '';
              });
            }
          });
      
          root.addEventListener('keydown', (e) => {
            if (e.key === 'ArrowLeft')  { advance(-1); e.preventDefault(); }
            if (e.key === 'ArrowRight') { advance(1);  e.preventDefault(); }
          });
      
          // Initial render
          position();
      
          // Auto-advance every 5s, pause on container hover
          let auto = setInterval(() => advance(1), 5000);
          root.addEventListener('mouseenter', () => clearInterval(auto));
          root.addEventListener('mouseleave', () => { auto = setInterval(() => advance(1), 5000); });
        })();
      </script>
      <script is:inline>
        /* Hero h1 typewriter — preserves <em> formatting while typing */
        (function heroTypewriterIIFE() {
          const h1 = document.querySelector('.hero h1');
          if (!h1 || h1.dataset.typed === '1') return;
          h1.dataset.typed = '1';
      
          const originalHTML = h1.innerHTML;
      
          // Flatten the DOM into [{ch, em}] list
          const parts = [];
          const temp = document.createElement('div');
          temp.innerHTML = originalHTML;
          (function walk(node, inEm) {
            for (const child of node.childNodes) {
              if (child.nodeType === 3) {
                for (const ch of child.textContent) parts.push({ ch, em: inEm });
              } else if (child.tagName === 'EM') {
                walk(child, true);
              } else {
                walk(child, inEm);
              }
            }
          })(temp, false);
      
          h1.innerHTML = '<span class="typing-content"></span><span class="typing-cursor" aria-hidden="true">|</span>';
          const content = h1.querySelector('.typing-content');
      
          let html = '';
          let inEm = false;
          let i = 0;
          function step() {
            if (i >= parts.length) {
              content.innerHTML = originalHTML;
              return;
            }
            const p = parts[i];
            if (p.em && !inEm)      { html += '<em>';  inEm = true;  }
            else if (!p.em && inEm) { html += '</em>'; inEm = false; }
            html += p.ch;
            content.innerHTML = inEm ? html + '</em>' : html;
            i++;
            setTimeout(step, 34 + Math.random() * 16);
          }
      
          setTimeout(step, 450);
        })();
      </script>
      <script is:inline>
        /* MagnetLines: vanilla JS port of React Bits component.
           Renders a grid of line elements that rotate to face the cursor when the
           pointer moves inside the hero. Uses cached element centers + rAF
           throttling for smooth performance with many lines. */
        (function magnetLinesIIFE() {
          const container = document.getElementById('heroMagnetLines');
          if (!container) return;
          const hero = container.closest('.hero');
          if (!hero) return;
      
          // Skip on reduced-motion preference
          if (window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
            return;
          }
      
          const isMobile = window.matchMedia && window.matchMedia('(max-width: 720px)').matches;
          const ROWS = isMobile ? 12 : 10;
          const COLS = isMobile ? 10 : 16;
          const BASE_ANGLE = -10;
      
          // Populate grid
          const frag = document.createDocumentFragment();
          const total = ROWS * COLS;
          for (let i = 0; i < total; i++) {
            const span = document.createElement('span');
            span.style.setProperty('--rotate', BASE_ANGLE + 'deg');
            frag.appendChild(span);
          }
          container.appendChild(frag);
          const items = container.querySelectorAll('span');
      
          // Cache each line's center, relative to the container
          let centers = [];
          function recomputeCenters() {
            const cr = container.getBoundingClientRect();
            centers = Array.from(items).map(item => {
              const r = item.getBoundingClientRect();
              return {
                cx: r.x - cr.x + r.width / 2,
                cy: r.y - cr.y + r.height / 2,
              };
            });
          }
          recomputeCenters();
          window.addEventListener('resize', recomputeCenters);
      
          // rAF-throttled pointermove handler. Pointermove fires on the hero
          // container (so it is naturally hover-scoped); while the pointer is
          // outside the hero, this listener is silent.
          let rafPending = false;
          let lastPX = 0, lastPY = 0;
          function onPointerMove(e) {
            lastPX = e.clientX;
            lastPY = e.clientY;
            if (rafPending) return;
            rafPending = true;
            requestAnimationFrame(flush);
          }
          function flush() {
            rafPending = false;
            const cr = container.getBoundingClientRect();
            const px = lastPX - cr.x;
            const py = lastPY - cr.y;
            for (let i = 0; i < items.length; i++) {
              const c = centers[i];
              if (!c) continue;
              const dx = px - c.cx;
              const dy = py - c.cy;
              const dist = Math.sqrt(dx * dx + dy * dy) || 1;
              const rotDeg = (Math.acos(dx / dist) * 180 / Math.PI) * (py > c.cy ? 1 : -1);
              items[i].style.setProperty('--rotate', rotDeg + 'deg');
            }
          }
      
          // Scope hover-trigger: attach pointermove on the hero itself, so the
          // interaction only runs when the pointer is over the hero.
          hero.addEventListener('pointermove', onPointerMove);
      
          // On leave, relax lines back to base angle
          hero.addEventListener('pointerleave', function() {
            for (let i = 0; i < items.length; i++) {
              items[i].style.setProperty('--rotate', BASE_ANGLE + 'deg');
            }
          });
        })();
      </script>
</body>
</html>